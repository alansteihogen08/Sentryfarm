rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /config/setores_hospital {
      allow read, write: if signedIn();
    }

    match /evolucoes_setores/{documentId} {
      allow read, write: if signedIn();
    }
  }
}
